{
  "name": "React + Vite Development",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "forwardPorts": [5173, 9200, 4567],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "9200": {
      "label": "OpenSearch",
      "onAutoForward": "notify"
    },
    "4567": {
      "label": "Search Parser Service",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "npm install",

  "remoteUser": "node",
  
  "mounts": [
    "source=${localWorkspaceFolder}/.idea,target=${containerWorkspaceFolder}/.idea,type=bind,consistency=cached"
  ],

  "customizations": {
    "jetbrains": {
      "plugins": [
        "com.intellij.ml.llm",
        "com.github.copilot"
      ]
    }
  }
}
